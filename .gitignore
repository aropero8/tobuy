# Dependencias
node_modules/

# Build web (se regenera con npm run build)
dist/

# Android: la carpeta android/ SÍ se sube; Capacitor genera su propio
# android/.gitignore para excluir builds, .gradle y local.properties.

# Variables de entorno / secretos
.env
.env.*
!.env.example

# Firmas de la app Android (¡nunca subirlas!)
*.jks
*.keystore
keystore.properties

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Emuladores de Firebase (npx firebase-tools emulators:start)
firebase-debug.log
firestore-debug.log

# Claude Code: ajustes locales de cada persona (launch.json sí se sube)
.claude/settings.local.json

# Sistema / editores
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
